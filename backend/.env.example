# Copy to secure runtime configuration. Never commit actual keys.
WIKSHI_PUBLIC_ORIGIN=https://api.wikshi.xyz
WIKSHI_DB=/var/lib/wikshi/wikshi.sqlite
WIKSHI_DATA_KEY=
WIKSHI_MERCHANT_ACCOUNT=
WIKSHI_MERCHANT_KEY=
PORT=8080
# Prices are integer USDC atomic units (1 USDC = 1000000). No default paid rates.
WIKSHI_PRICE_INSPECT=1
WIKSHI_PRICE_SEARCH=
WIKSHI_PRICE_CONTENTS=
WIKSHI_PRICE_ENRICH=
WIKSHI_PRICE_CONTACT_PHONE=
WIKSHI_PRICE_REVERSE=
WIKSHI_PRICE_COMPANY_CONTACTS=
WIKSHI_PRICE_INBOX=
WIKSHI_PRICE_EMAIL=
WIKSHI_PRICE_PHONE_SECOND=
WIKSHI_PRICE_VIDEO_SECOND=
EXA_API_KEY=
QUICKENRICH_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
WIKSHI_EMAIL_DOMAIN=
# Set true only after verifying sending DNS, receiving MX, signed webhook delivery.
WIKSHI_EMAIL_READY=false
AGENTPHONE_API_KEY=
AGENTPHONE_AGENT_ID=
BEY_API_KEY=
BEY_AVATAR_ID=
# Only explicitly approved email addresses and E.164 phone numbers can be contacted on testnet.
WIKSHI_TESTNET_RECIPIENTS=
