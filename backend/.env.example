# Copy to secure runtime configuration. Never commit actual keys.
WIKSHI_PUBLIC_ORIGIN=https://api.wikshi.xyz
WIKSHI_DB=/var/lib/wikshi/wikshi.sqlite
WIKSHI_DATA_KEY=
WIKSHI_MERCHANT_ACCOUNT=
WIKSHI_MERCHANT_KEY=
PORT=8080
# Prices are integer USDC atomic units (1 USDC = 1000000). No default paid rates.
WIKSHI_PRICE_INSPECT=1
WIKSHI_PRICE_SEARCH=
WIKSHI_PRICE_CONTENTS=
WIKSHI_PRICE_ENRICH=
WIKSHI_PRICE_CONTACT_PHONE=
WIKSHI_PRICE_REVERSE=
WIKSHI_PRICE_COMPANY_CONTACTS=
# Explicit inbox creation uses this rate, or the EMAIL rate when blank.
WIKSHI_PRICE_INBOX=
WIKSHI_PRICE_EMAIL=
WIKSHI_PRICE_PHONE_SECOND=
WIKSHI_PRICE_VIDEO_SECOND=
# Optional independent HBAR rates in tinybars (1 HBAR = 100000000).
# Blank disables this asset for that service, except INBOX falls back to EMAIL.
# The fallback is per asset; there is no implicit currency conversion.
WIKSHI_PRICE_INSPECT_HBAR=
WIKSHI_PRICE_SEARCH_HBAR=
WIKSHI_PRICE_CONTENTS_HBAR=
WIKSHI_PRICE_ENRICH_HBAR=
WIKSHI_PRICE_CONTACT_PHONE_HBAR=
WIKSHI_PRICE_REVERSE_HBAR=
WIKSHI_PRICE_COMPANY_CONTACTS_HBAR=
WIKSHI_PRICE_INBOX_HBAR=
WIKSHI_PRICE_EMAIL_HBAR=
WIKSHI_PRICE_PHONE_SECOND_HBAR=
WIKSHI_PRICE_VIDEO_SECOND_HBAR=
EXA_API_KEY=
QUICKENRICH_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
WIKSHI_EMAIL_DOMAIN=
# Set true only after verifying sending DNS, receiving MX, signed webhook delivery.
WIKSHI_EMAIL_READY=false
AGENTPHONE_API_KEY=
AGENTPHONE_AGENT_ID=
BEY_API_KEY=
BEY_AVATAR_ID=
# Enable only after confirming the account permits API call creation.
WIKSHI_VIDEO_API_READY=false
WIKSHI_VIDEO_MODE=hosted
# Optional 32-byte base64url callback token (43 characters), generated privately.
# Configure Studio call_ended events at /v1/webhooks/video/<token>.
# The existing worker remains the fallback; never put this token in client code.
WIKSHI_VIDEO_WEBHOOK_TOKEN=
# Calls have no Wikshi-enforced hangup. maxSeconds is the prepaid billing ceiling.
WIKSHI_PHONE_ENABLED=false
# Public testnet access: any valid testnet payer and recipient may use enabled services.
# Testnet payments do not offset real provider usage costs. Consent and ownership remain mandatory.
